# Realtime WebSocket Gateway
NODE_ENV=development
PORT=3002

# Redis
REDIS_URL=redis://localhost:6379

# CORS - origins allowed to connect
ALLOWED_ORIGINS=http://localhost:3000,https://rede-social-rho-five.vercel.app

# JWT (must match the API that issues vibra_session cookies)
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ISSUER=orbit
JWT_AUDIENCE=orbit-client

# Internal API for fetching friend lists
API_URL=http://localhost:4173
INTERNAL_API_KEY=your-internal-api-key