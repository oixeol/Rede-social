{
  "name": "vibra",
  "version": "2.0.0",
  "private": true,
  "description": "Rede social local com descoberta de afinidades e área de namoro verificada.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed:demo": "node scripts/seed-demo.mjs",
    "test": "node qa/run-tests.mjs",
    "frontend:dev": "npm --prefix ../../frontend run dev",
    "frontend:build": "npm --prefix ../../frontend run build",
    "frontend:start": "npm --prefix ../../frontend run start",
    "frontend:lint": "npm --prefix ../../frontend run lint",
    "frontend:typecheck": "npm --prefix ../../frontend run typecheck",
    "frontend:check": "npm run frontend:lint && npm run frontend:typecheck && npm run frontend:build"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "better-auth": "^1.7.22",
    "bull": "^4.16.5",
    "kysely": "^0.29.9",
    "minio": "^8.0.7",
    "pg": "^8.16.3",
    "redis": "^6.3.1",
    "ws": "^8.22.2"
  }
}
