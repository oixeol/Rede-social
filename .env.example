# Copie para .env apenas em ambiente local. Nunca versione segredos reais.

# Porta e interface. O padrão escuta apenas em 127.0.0.1.
PORT=4173
HOST=127.0.0.1

# development, test ou production. Produção recusa seed e simulação de identidade.
NODE_ENV=development

# Diretório do SQLite e dos uploads.
VIBRA_DATA_DIR=./data

# Dados de demonstração são opt-in e proibidos em produção.
# A senha precisa ter pelo menos 8 caracteres e não possui valor padrão.
VIBRA_SEED_DEMO=0
VIBRA_DEMO_PASSWORD=

# Identidade do Namoro: vazio, dev ou webhook.
# Produção exige webhook com segredo, ou o Namoro permanece bloqueado.
IDENTITY_PROVIDER=
IDENTITY_WEBHOOK_SECRET=

# Libera a fila de moderação pelo header X-Admin-Token.
ADMIN_TOKEN=

# 1 força o atributo Secure; produção já o força. 0 só é aceito fora de produção.
COOKIE_SECURE=0

# Retenção de localização do Radar, em milissegundos.
LOCATION_RETENTION_MS=86400000
CLEANUP_INTERVAL_MS=900000
